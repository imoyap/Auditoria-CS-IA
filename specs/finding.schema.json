{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Finding Specification",
  "version": "1.0.0",
  "description": "Formal specification for security audit findings",
  "type": "object",
  "properties": {
    "id": {
      "type": ["integer", "null"],
      "description": "Database ID (null until persisted)"
    },
    "audit_id": {
      "type": ["integer", "null"],
      "description": "Parent audit ID"
    },
    "run_id": {
      "type": ["string", "null"],
      "description": "UUID of parent audit run"
    },
    "check_id": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,5}-[0-9]{3}$",
      "description": "Unique check identifier (e.g., SYS-001, NET-042, SSL-007)",
      "examples": ["SYS-001", "NET-001", "SSL-001", "FS-001", "SEC-001"]
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200,
      "description": "Finding title (human-readable summary)"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000,
      "description": "Detailed description of the finding"
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"],
      "description": "Risk severity level"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "warn", "error", "skip"],
      "description": "Check execution status"
    },
    "module": {
      "type": "string",
      "enum": ["system", "network", "ssl", "filesystem", "secrets"],
      "description": "Which audit module detected this finding"
    },
    "category": {
      "type": "string",
      "description": "Category within module (e.g., 'sistema', 'red', 'archivos')"
    },
    "evidence": {
      "type": ["object", "array", "string", "null"],
      "description": "Raw technical evidence (structure varies by check)",
      "examples": [
        {"os": "Windows 10 (10.0.26200)", "architecture": "AMD64"},
        {"status": "ON", "domain": true, "private": true, "public": true},
        "C:\\Sensitive\\config.txt (permissions: 777)"
      ]
    },
    "recommendation": {
      "type": ["string", "null"],
      "maxLength": 500,
      "description": "Suggested remediation or mitigation"
    },
    "references": {
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "format": "uri"
      },
      "description": "External references (CVE, CWE, documentation links)"
    },
    "validation": {
      "type": "object",
      "description": "Finding validation and confirmation state",
      "properties": {
        "state": {
          "type": "string",
          "enum": ["unreviewed", "accepted", "rejected", "disputed", "verified"],
          "default": "unreviewed",
          "description": "Human validation state"
        },
        "validated_by": {
          "type": ["string", "null"],
          "description": "Username of reviewer"
        },
        "validated_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO 8601 timestamp of validation"
        },
        "is_false_positive": {
          "type": "boolean",
          "default": false,
          "description": "Whether this is a known false positive"
        },
        "suppression_reason": {
          "type": ["string", "null"],
          "description": "Why finding is suppressed (if applicable)"
        },
        "suppressed_until": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Suppression expiration date"
        }
      }
    },
    "ai_enrichment": {
      "type": ["object", "null"],
      "description": "AI-generated analysis of this finding",
      "properties": {
        "analysis": {
          "type": "string",
          "description": "Claude-generated analysis"
        },
        "model_used": {
          "type": "string",
          "description": "Claude model that generated this"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence in the analysis (0.0-1.0)"
        },
        "tokens_used": {
          "type": "integer",
          "minimum": 0,
          "description": "Tokens consumed by Claude"
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0,
          "description": "API call latency in milliseconds"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "disclaimers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Warnings about analysis limitations"
        }
      }
    },
    "remediation": {
      "type": ["object", "null"],
      "description": "Remediation tracking",
      "properties": {
        "action_plan": {
          "type": "string"
        },
        "assigned_to": {
          "type": "string"
        },
        "due_date": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "completed", "deferred", "waived"]
        },
        "completion_date": {
          "type": ["string", "null"],
          "format": "date"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when finding was created"
    },
    "updated_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    }
  },
  "required": [
    "check_id",
    "title",
    "description",
    "severity",
    "status",
    "module",
    "created_at"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "check_id": "SYS-003",
      "title": "Estado del Firewall de Windows",
      "description": "Firewall activo en todos los perfiles",
      "severity": "info",
      "status": "pass",
      "module": "system",
      "category": "sistema",
      "evidence": {
        "firewall_output": "State: ON\nDomain Profile: ON\nPrivate Profile: ON\nPublic Profile: ON"
      },
      "recommendation": "Active el Firewall de Windows en perfiles Dominio, Privado y Público.",
      "references": ["https://learn.microsoft.com/windows/security/operating-system-security/network-security/windows-firewall/"],
      "validation": {
        "state": "unreviewed"
      },
      "created_at": "2026-07-28T14:50:05Z"
    },
    {
      "check_id": "NET-001",
      "title": "Puertos abiertos detectados",
      "description": "Se encontraron 1 puerto(s) abierto(s).",
      "severity": "high",
      "status": "fail",
      "module": "network",
      "category": "red",
      "evidence": {
        "open_ports": [5000],
        "services": [{"port": 5000, "service": "http-alt"}]
      },
      "recommendation": "Cierre puertos innecesarios y restrinja el acceso con firewall.",
      "validation": {
        "state": "accepted",
        "validated_by": "security-team",
        "validated_at": "2026-07-28T15:00:00Z",
        "is_false_positive": false
      },
      "created_at": "2026-07-28T14:50:15Z"
    }
  ]
}
